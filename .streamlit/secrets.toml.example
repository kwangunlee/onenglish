# ─────────────────────────────────────────────────────────────
#  이 파일을 복사해서 "secrets.toml" 로 이름을 바꾸고 값을 채우세요.
#  secrets.toml 은 .gitignore 에 등록되어 있어 깃허브에 올라가지 않습니다.
#
#  나중에 Streamlit Cloud 에 올릴 때는 이 파일을 올리는 게 아니라,
#  앱 설정 화면의 "Secrets" 칸에 같은 내용을 붙여넣으면 됩니다.
#  코드는 양쪽에서 똑같이 동작합니다.
# ─────────────────────────────────────────────────────────────

# [필수] OpenAI API 키  https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-여기에_새로_발급받은_키_붙여넣기"

# [선택] 모델. 기본값 그대로 두는 걸 권장합니다.
CHAT_MODEL = "gpt-4o-mini"
STT_MODEL = "whisper-1"
TTS_MODEL = "gpt-4o-mini-tts"

# [선택] AI 에게 넘길 직전 대화 수. 늘리면 맥락을 더 기억하지만 비용이 늘어납니다.
MAX_HISTORY_TURNS = 12

# [선택] 캐릭터 답변 최대 길이(토큰). 아이용이라 짧게 유지하는 게 좋습니다.
MAX_REPLY_TOKENS = 120

# [선택] 캐릭터 프롬프트에 넣을 지난 기억 개수.
MEMORY_RECALL_COUNT = 6

# [선택] 음성 합성을 누가 할지. 성격이 정반대라 취향대로 고르세요.
#   openai   연기 지시를 반영 → 생기 있음, 음색이 미세하게 흔들림
#   google   텍스트와 속도만  → 음색이 일정함, 상황별 톤 변화 없음
#            (예전 tkinter 버전이 쓰던 Chirp3-HD 가 이쪽입니다)
# 캐릭터마다 다르게 쓰고 싶으면 characters.json 의 "tts_provider" 를 쓰세요.
TTS_PROVIDER = "openai"

# [TTS_PROVIDER = "google" 일 때 필수] Google Text-to-Speech API 키.
#   1. https://console.cloud.google.com 에서 Cloud Text-to-Speech API 사용 설정
#   2. 사용자 인증 정보 → API 키 만들기
#   3. 만든 키는 "API 제한"에서 Text-to-Speech 만 허용하도록 꼭 제한하세요
# 서비스 계정 JSON 파일은 필요 없습니다. API 키 하나면 됩니다.
GOOGLE_TTS_KEY = ""

# [선택] 목소리 일관성 ↔ 생기. TTS_PROVIDER = "openai" 일 때만 의미가 있습니다.
#        (google 목소리는 연기 지시를 받지 않아 항상 일정합니다)
#   stable     목소리가 가장 일정함. 대신 어떤 얘기를 들어도 같은 톤
#   balanced   그 순간의 기분(신남·위로 등)을 반영. 기본값
#   expressive 기분 + 아이가 방금 한 말까지 반영. 가장 생생하지만
#              문장마다 목소리가 조금씩 달라지는 느낌이 들 수 있음
#
# 들어보고 고르려면:  python tools/voice_test.py --drift
VOICE_MODE = "balanced"

# [필수 — 인터넷에 공개할 때만] 앱 전체 접속 비밀번호.
# 비워두면 비밀번호 없이 누구나 들어옵니다. 집에서만 쓸 때는 비워도 됩니다.
# Streamlit Cloud 에 올릴 거라면 반드시 채우세요. 아이 대화 기록이 들어있습니다.
APP_PASSWORD = ""
