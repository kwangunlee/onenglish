# ─────────────────────────────────────────────────────────────
#  OnEnglish 설정 파일 템플릿
#  이 파일을 복사해서 "secrets.toml" 로 이름을 바꾸고 값을 채우세요.
#  secrets.toml 은 .gitignore 에 있어 깃허브에 올라가지 않습니다.
#
#  Streamlit Cloud 에 올릴 때는 이 파일을 올리는 게 아니라,
#  앱 설정의 "Secrets" 칸에 같은 내용을 붙여넣으면 됩니다.
#  코드는 양쪽에서 똑같이 동작합니다.
# ─────────────────────────────────────────────────────────────


# ══ 1. 어느 쪽을 쓸지 ═══════════════════════════════════════════
#
#   "google"  Gemini + Google 음성.  키 하나로 전부. 카드 없이 무료 한도 있음
#   "openai"  GPT + Whisper + OpenAI 음성.  선불 충전 필요
#
# 이 한 줄이 대화·음성인식·음성합성을 모두 바꿉니다.
AI_PROVIDER = "google"


# ══ 2. 키 ══════════════════════════════════════════════════════

# [AI_PROVIDER = "google" 일 때 필수]
#   키 발급: https://aistudio.google.com/apikey  → Create API key
#   서비스 계정 JSON 파일은 필요 없습니다. API 키 하나면 됩니다.
#
#   음성합성까지 쓰려면 같은 프로젝트에서 이 API 도 사용 설정하세요:
#     https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
#
#   확인: python tools/check_google.py
GOOGLE_API_KEY = ""

# [AI_PROVIDER = "openai" 일 때 필수]
#   키 발급: https://platform.openai.com/api-keys
#   크레딧이 0 이면 키가 있어도 동작하지 않습니다.
OPENAI_API_KEY = ""


# ══ 3. 누가 들어올 수 있는가 ════════════════════════════════════
#
# 기본 동작: 첫 화면은 사람 목록만 보이고, 이름을 고르면 그 사람의 비밀번호를
# 묻습니다. 그 비밀번호는 앱 안에서 사람을 만들 때 각자 정합니다.
# 아래 두 개는 그 위에 더 얹는 선택 사항입니다.

# [선택] 앱에 들어오는 모든 사람에게 첫 화면에서 묻는 비밀번호.
# 아이들도 매번 입력해야 해서 번거롭습니다.
# 인터넷에 공개한 주소라면, 모르는 사람이 새 프로필을 만들어 API 비용을
# 쓰는 것을 막는 유일한 장치이니 채워두는 것을 권장합니다.
APP_PASSWORD = ""

# [선택] 기록 보기(대화 로그·기억·학습기록)를 열 때 묻는 비밀번호.
PARENT_PASSWORD = ""


# ══ 데이터베이스 (선택) ══════════════════════════════════════════
#
# 비워두면 이 컴퓨터의 data/onenglish.db (SQLite 파일)에 저장합니다.
# Streamlit Cloud 처럼 재시작 때 파일이 지워지는 곳에 올릴 거라면
# Google Firestore 를 쓰세요 (무료 한도 안에서 0원).
# 순서는 README 의 "Firestore 연결(무료)".
#
#   "sqlite"    이 컴퓨터의 파일 (기본값)
#   "firestore" Google Firestore — 무료 한도 있음, 추천
#   "cloudsql"  Google Cloud SQL — 유료, 아래 CLOUD_SQL_* 필요
DB_BACKEND = ""

# Firestore 프로젝트 ID. 비워두면 서비스 계정 키의 project_id 를 씁니다.
# FIRESTORE_PROJECT = "onenglish-chat"

# ── (유료) Cloud SQL 을 쓸 때만 ──
# Cloud SQL 인스턴스 "연결 이름" (콘솔의 인스턴스 개요 화면에 있음)
# 예: "my-project:asia-northeast3:onenglish-db"
# CLOUD_SQL_INSTANCE = ""
# DB_USER = "onenglish"
# DB_PASSWORD = ""
# DB_NAME = "onenglish"

# 서비스 계정 키 (Firestore·Cloud SQL 공통). 키 파일(JSON)의 내용을 아래 표로 옮겨 적습니다.
# 이 컴퓨터에서 gcloud auth application-default login 을 했다면 생략해도 됩니다.
# Streamlit Cloud 에서는 반드시 필요합니다.
# [gcp_service_account]
# type = "service_account"
# project_id = "my-project"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "onenglish-db@my-project.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
# (주의: 이 표는 파일 맨 끝에 두세요. TOML 에서는 표 아래 줄이 모두 그 표에 속합니다.)


# ══ 4. 세부 설정 (보통 손댈 필요 없음) ═══════════════════════════

# 기능별로 다른 쪽을 쓰고 싶을 때만. 비워두면 AI_PROVIDER 를 따릅니다.
# 예: 대화는 Google, 목소리는 OpenAI
# CHAT_PROVIDER = "google"
# STT_PROVIDER  = "google"
# TTS_PROVIDER  = "openai"

# Google 모델 이름. 모델 이름은 바뀔 수 있습니다.
# "모델을 찾을 수 없어요" 가 나오면 아래로 목록을 보고 바꾸세요:
#     python tools/check_google.py --models
# GEMINI_CHAT_MODEL = "gemini-3.8-flash"
# GEMINI_STT_MODEL  = "gemini-3.8-flash"

# OpenAI 모델 이름.
# CHAT_MODEL = "gpt-4o-mini"
# STT_MODEL  = "whisper-1"
# TTS_MODEL  = "gpt-4o-mini-tts"

# AI 에게 넘길 직전 대화 수. 늘리면 맥락을 더 기억하지만 비용이 늘어납니다.
MAX_HISTORY_TURNS = 12

# 캐릭터 답변 최대 길이(토큰). 아이용이라 짧게 유지하는 게 좋습니다.
MAX_REPLY_TOKENS = 120

# 캐릭터 프롬프트에 넣을 지난 기억 개수.
MEMORY_RECALL_COUNT = 6

# 목소리 일관성 ↔ 생기. TTS_PROVIDER 가 openai 일 때만 의미가 있습니다.
#   stable      지시문 고정. 음색이 가장 일정하고 톤 변화는 없음
#   balanced    그 순간의 기분만 반영. 기본값
#   expressive  기분 + 아이가 방금 한 말까지 반영. 가장 생생하지만 가장 흔들림
# 들어보고 고르려면: python tools/voice_test.py --drift
VOICE_MODE = "balanced"
